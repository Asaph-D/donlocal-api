apiVersion: apps/v1
kind: Deployment
metadata:
  name: donlocal-api
spec:
  replicas: 2
  selector:
    matchLabels:
      app: donlocal-api
  template:
    metadata:
      labels:
        app: donlocal-api
    spec:
      containers:
      - name: api
        image: "{{ IMAGE_NAME }}"
        env:
          - name: DB_HOST
            value: postgres
          - name: DB_PORT
            value: "5432"
        ports:
          - containerPort: 5000
---
apiVersion: v1
kind: Service
metadata:
  name: donlocal-api
spec:
  type: NodePort
  selector:
    app: donlocal-api
  ports:
    - port: 5000
      targetPort: 5000
