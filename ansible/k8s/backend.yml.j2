apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name | default('donlocal-api') }}
spec:
  replicas: {{ APP_REPLICAS | default(2) | int }}
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: {{ app_name | default('donlocal-api') }}
  template:
    metadata:
      labels:
        app: {{ app_name | default('donlocal-api') }}
    spec:
      initContainers:
      - name: wait-for-postgres
        image: postgres:15
        command:
          - sh
          - -c
          - "until pg_isready -h {{ DB_HOST | default('postgres') }} -p {{ DB_PORT | default(5432) }}; do sleep 1; done"
        resources:
          requests:
            cpu: "10m"
            memory: "16Mi"
      containers:
      - name: api
        image: "{{ IMAGE_NAME }}"
        env:
        # Variables DB_* (utilisées par le code Node.js)
        - name: DB_HOST
          value: "{{ DB_HOST | default('postgres') }}"
        - name: DB_PORT
          value: "{{ DB_PORT | default('5432') }}"
        - name: DB_NAME
          value: "{{ DB_NAME | default(postgres_db | default('donlocal')) }}"
        - name: DB_USER
          value: "{{ DB_USER | default(postgres_user | default('postgres')) }}"
        - name: DB_PASSWORD
          value: "{{ DB_PASSWORD | default(postgres_password | default('1234')) }}"
        # Variables POSTGRES_* (compatibilité et initContainers)
        - name: POSTGRES_HOST
          value: "{{ DB_HOST | default('postgres') }}"
        - name: POSTGRES_PORT
          value: "{{ DB_PORT | default('5432') }}"
        - name: POSTGRES_DB
          value: "{{ postgres_db | default('donlocal') }}"
        - name: POSTGRES_USER
          value: "{{ postgres_user | default('postgres') }}"
        - name: POSTGRES_PASSWORD
          value: "{{ postgres_password | default('1234') }}"
        # Variables serveur
        - name: NODE_ENV
          value: "production"
        - name: PORT
          value: "{{ APP_PORT | default('5000') }}"
        ports:
        - containerPort: {{ APP_PORT | default(5000) }}
          name: http
        resources:
          requests:
            memory: "128Mi"
            cpu: "100m"
          limits:
            memory: "256Mi"
            cpu: "500m"
        livenessProbe:
          httpGet:
            path: /api/health
            port: {{ APP_PORT | default(5000) }}
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /api/health
            port: {{ APP_PORT | default(5000) }}
          initialDelaySeconds: 5
          periodSeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: {{ app_name | default('donlocal-api') }}
spec:
  type: {{ SERVICE_TYPE | default('NodePort') }}
  selector:
    app: {{ app_name | default('donlocal-api') }}
  ports:
  - port: {{ APP_PORT | default(5000) }}
    targetPort: {{ APP_PORT | default(5000) }}
    protocol: TCP
    name: http
